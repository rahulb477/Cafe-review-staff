# Firebase Web App configuration for the cafe-review7 project.
# Set these public variables in Vercel before the production build.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cafe-review7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cafe-review7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cafe-review7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
