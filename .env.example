# Cafe Review Staff App — Firebase Web App configuration
#
# Project: cafe-review7 (the SAME project as the Customer and Admin apps).
# Do NOT create another Firebase project, Firestore database or auth system.
# Only these six variables are used. There is no DATABASE_URL and no SQL backend.
#
# Copy to `.env.local` (or set them in Vercel → Project → Settings → Environment
# Variables) and replace every placeholder — the app refuses to start against a
# placeholder/dummy value or a project other than cafe-review7.

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cafe-review7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cafe-review7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cafe-review7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
